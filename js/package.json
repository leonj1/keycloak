{
  "name": "keycloak-rust-admin-console",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "wireit",
    "start": "node apps/admin-ui/scripts/serve.mjs",
    "typecheck": "corepack pnpm --filter @keycloak/keycloak-admin-ui exec tsc -p tsconfig.json",
    "test": "corepack pnpm --filter @keycloak/keycloak-admin-ui --filter @keycloak/keycloak-ui-shared --filter @keycloak/keycloak-admin-client test",
    "test:proxy": "node --test apps/admin-ui/scripts/console-server.test.mjs",
    "test:browser": "node apps/admin-ui/scripts/browser-smoke.mjs"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./apps/admin-ui:build"
      ]
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lodash": "^8.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "~6.1.0",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.42.0",
    "wireit": "^0.15.0"
  },
  "author": {
    "name": "Red Hat, Inc.",
    "url": "https://www.keycloak.org/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/keycloak/keycloak.git",
    "directory": "js/"
  },
  "homepage": "https://www.keycloak.org/"
}
